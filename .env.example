# Cyber Lab IN environment reference. Copy frontend values to cyberscout/.env and
# backend values to cyberscout-server/.env. Never commit either real .env file.

# Frontend
# Leave VITE_API_URL unset in Vercel so browser requests use the same-origin /api proxy.
VITE_API_URL=http://localhost:3001
VITE_SITE_URL=https://cyberlabin.com

# Backend application and browser origins
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=256kb

# Authentication and cookies
JWT_SECRET=change_me_to_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_COST=12
VISITOR_HASH_SALT=change_me_to_random_visitor_hash_salt
LAB_FLAG_SALT=change_me_to_random_lab_flag_salt

# Database
DATABASE_URL=file:./data/cyberlab.sqlite
DB_MIGRATION_LOG=1
SEED_BASELINE_FORCE=0
# Development-only test account password. Production startup never creates these identities.
SEED_USER_PASSWORD=replace_for_local_seed_accounts

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Production uses the public first-party callback routed through Vercel:
# GOOGLE_CALLBACK_URL=https://cyberlabin.com/api/auth/google/callback

# Request throttling
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
LEAD_RATE_LIMIT=8
AI_RATE_LIMIT=40

# Course-bound tutor
AI_DAILY_LIMIT=20

# Razorpay (optional; configure all three together)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CLI administration
CLIADM_ADMIN_TOKEN=replace_with_random_admin_token
