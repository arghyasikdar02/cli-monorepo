# Frontend: copy these values to cyberscout/.env for local development.
VITE_API_URL=http://localhost:3001
VITE_SITE_URL=https://cyberlabin.com

# Backend: copy the remaining values to cyberscout-server/.env.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173

# Generate production secrets with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
VISITOR_HASH_SALT=replace-with-a-random-secret-at-least-24-characters
LAB_FLAG_SALT=replace-with-a-random-secret-at-least-24-characters
CLIADM_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
BCRYPT_COST=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

DATABASE_PATH=./data/cyberlab.sqlite
DB_MIGRATION_LOG=1
SEED_BASELINE_FORCE=0
SEED_USER_PASSWORD=

JSON_BODY_LIMIT=256kb
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
LEAD_RATE_LIMIT=8
AI_RATE_LIMIT=40
AI_DAILY_LIMIT=20

# Optional integrations. Configure each complete group or leave it empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Render overrides NODE_ENV, URLs, COOKIE_SECURE and DATABASE_PATH. See RENDER_DEPLOYMENT.md.
