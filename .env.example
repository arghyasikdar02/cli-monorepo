# Frontend: copy these values to cyberscout/.env for local development.
VITE_API_URL=http://localhost:3001
VITE_SITE_URL=https://cyberlabin.com

# Backend: copy the remaining values to cyberscout-server/.env.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173

# Generate production secrets with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
VISITOR_HASH_SALT=replace-with-a-random-secret-at-least-24-characters
LAB_FLAG_SALT=replace-with-a-random-secret-at-least-24-characters
CLIADM_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
BCRYPT_COST=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

DATABASE_URL=postgresql://postgres:replace-with-supabase-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_SSL=require
# Optional PEM CA chain. Keep empty when the Supabase certificate chains to a trusted system root.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=cyberlabin-api
# Local development only. Never enable this in production.
SEED_DEVELOPMENT_USERS=0
SEED_USER_PASSWORD=

JSON_BODY_LIMIT=256kb
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
LEAD_RATE_LIMIT=8
AI_RATE_LIMIT=40
AI_DAILY_LIMIT=20

# Optional integrations. Configure each complete group or leave it empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Render overrides NODE_ENV, URLs and COOKIE_SECURE. Enter DATABASE_URL as a secret. See RENDER_DEPLOYMENT.md.
