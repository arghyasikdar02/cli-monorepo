# Cyber Lab IN environment template.
# Copy to .env.local for local development. Never commit real secrets.

# App
APP_ENV=local
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
LIVE_DEFAULT_JOIN_OPEN_MINUTES=15
AUDIT_LOG_RETENTION_DAYS=365

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database
DATABASE_URL=postgresql://cyberlabin:cyberlabin@localhost:5432/cyberlabin_dev?schema=public
DIRECT_URL=postgresql://cyberlabin:cyberlabin@localhost:5432/cyberlabin_dev?schema=public

# Razorpay
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Auth/session
CLIADM_API_URL=http://localhost:3000
CLIADM_ADMIN_TOKEN=change-me-local-only
DOCUMENT_PAGE_TOKEN_SECRET=change-me-local-only
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_ROLES=admin,instructor,student,sales_agent

# Storage
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cyberlabin-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AI/RAG provider
AI_PROVIDER=mock
AI_API_KEY=
EMBEDDING_PROVIDER=mock

# Feature flags
FEATURE_RAZORPAY_WEBHOOKS=false
FEATURE_PROTECTED_DOCUMENTS=true
FEATURE_MOCK_AI=true
FEATURE_MANUAL_LABS=true
RATE_LIMIT_REDIS_URL=
EMAIL_PROVIDER=manual
RESEND_API_KEY=
