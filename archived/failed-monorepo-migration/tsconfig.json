{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@cyberlabin/ui": ["packages/ui/src/index.tsx"],
      "@cyberlabin/types": ["packages/types/src/index.ts"],
      "@cyberlabin/config": ["packages/config/src/index.ts"],
      "@cyberlabin/logger": ["packages/logger/src/index.ts"],
      "@cyberlabin/database": ["packages/database/src/index.ts"],
      "@cyberlabin/api-client": ["packages/api-client/src/index.ts"],
      "@cyberlabin/auth-guards": ["packages/auth-guards/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "services/**/*.ts", "packages/**/*.ts", "packages/**/*.tsx"],
  "exclude": ["node_modules", ".next"]
}