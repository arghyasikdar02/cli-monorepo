{
  "name": "cyberscout-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "NODE_ENV=test DATABASE_URL=file:./data/test.sqlite JWT_SECRET=test_secret_at_least_32_chars CLIADM_ADMIN_TOKEN=test_admin_token node --test tests/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
