NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=256kb

# Authentication and cookies
JWT_SECRET=change_me_to_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
VISITOR_HASH_SALT=change_me_to_random_visitor_hash_salt
LAB_FLAG_SALT=change_me_to_random_lab_flag_salt

# Database
# Local durable SQLite database. Keep this file private and back it up before destructive changes.
DATABASE_URL=file:./data/cyberlab.sqlite
BCRYPT_COST=12
# Development-only test account password. Ignored for production identity creation.
SEED_USER_PASSWORD=replace_for_local_seed_accounts
DB_MIGRATION_LOG=1
# Set to 1 only when you intentionally want to re-apply baseline seed content.
SEED_BASELINE_FORCE=0

# Google OAuth
# Local authorized redirect URI:
# http://localhost:3001/api/auth/google/callback
# Deployed authorized redirect URI (first-party Vercel proxy):
# https://cyberlabin.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional override if the Google callback should differ from BACKEND_URL + /api/auth/google/callback
# GOOGLE_CALLBACK_URL=https://cyberlabin.com/api/auth/google/callback

# Request throttling
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
LEAD_RATE_LIMIT=8
AI_RATE_LIMIT=40

# Course-bound AI tutor
AI_DAILY_LIMIT=20

# Razorpay starter
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CLI admin
CLIADM_ADMIN_TOKEN=replace_with_random_admin_token
