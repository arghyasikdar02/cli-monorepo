# Local development defaults. Production overrides are described below and in RENDER_DEPLOYMENT.md.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173

# Sessions and security. Generate production values with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
VISITOR_HASH_SALT=replace-with-a-random-secret-at-least-24-characters
LAB_FLAG_SALT=replace-with-a-random-secret-at-least-24-characters
CLIADM_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
BCRYPT_COST=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Supabase PostgreSQL. URL-level sslmode/sslcert/sslkey/sslrootcert options are ignored;
# DATABASE_SSL below is the single TLS policy for migrations, seeds, and the API.
DATABASE_URL=postgresql://postgres:replace-with-supabase-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_SSL=require
# Optional PEM CA chain. When set, the PostgreSQL client verifies the supplied CA.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=cyberlabin-api
# Development-only identity seed control. Production startup runs migrations only.
SEED_DEVELOPMENT_USERS=0
SEED_USER_PASSWORD=

# Request limits
JSON_BODY_LIMIT=256kb
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
LEAD_RATE_LIMIT=8
AI_RATE_LIMIT=40
AI_DAILY_LIMIT=20

# Optional Google OAuth and Google Meet. Keep secrets backend-only in Render.
GOOGLE_CLOUD_PROJECT_ID=cyber-lab-in
GOOGLE_CLOUD_PROJECT_NUMBER=854487433792
GOOGLE_CLIENT_ID=854487433792-1ntj74qq2qta3fei0a7qhhj650n2p5cv.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional Razorpay. Configure all three together.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production requirements:
# NODE_ENV=production
# FRONTEND_URL=https://cyberlabin.com
# BACKEND_URL=https://cli-hq1i.onrender.com
# CORS_ORIGINS=https://cyberlabin.com,https://www.cyberlabin.com
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# GOOGLE_REDIRECT_URI=https://cyberlabin.com/api/auth/google/callback
# DATABASE_URL=postgresql://... Supabase connection string entered as a Render secret
# DATABASE_SSL=require
# Set unique non-placeholder JWT_SECRET, VISITOR_HASH_SALT, LAB_FLAG_SALT and CLIADM_ADMIN_TOKEN values.
