# Local development defaults. Production overrides are described below and in RENDER_DEPLOYMENT.md.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173

# Sessions and security. Generate production values with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
VISITOR_HASH_SALT=replace-with-a-random-secret-at-least-24-characters
LAB_FLAG_SALT=replace-with-a-random-secret-at-least-24-characters
CLIADM_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
BCRYPT_COST=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Supabase PostgreSQL. Use a direct connection for migrations and a compatible pooler URL for runtime if required.
DATABASE_URL=postgresql://postgres:replace-with-supabase-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_SSL=require
# Optional PEM CA chain. Keep empty when the Supabase certificate chains to a trusted system root.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=cyberlabin-api
# Development-only seed controls. Production startup never runs the seed command.
SEED_DEVELOPMENT_USERS=0
SEED_USER_PASSWORD=

# Request limits
JSON_BODY_LIMIT=256kb
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
LEAD_RATE_LIMIT=8
AI_RATE_LIMIT=40
AI_DAILY_LIMIT=20

# Optional Google OAuth. Configure all three together in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional Razorpay. Configure all three together.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production requirements:
# NODE_ENV=production
# FRONTEND_URL=https://cyberlabin.com
# BACKEND_URL=https://cyberlabin.onrender.com
# CORS_ORIGINS=https://cyberlabin.com,https://www.cyberlabin.com
# COOKIE_SECURE=true
# DATABASE_URL=postgresql://... Supabase connection string entered as a Render secret
# DATABASE_SSL=require
# Set unique non-placeholder JWT_SECRET, VISITOR_HASH_SALT, LAB_FLAG_SALT and CLIADM_ADMIN_TOKEN values.
