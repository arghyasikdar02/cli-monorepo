PORT=3001
JWT_SECRET=change_me_to_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
VISITOR_HASH_SALT=change_me_to_random_visitor_hash_salt
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173

# Database
# Local durable SQLite database. Keep this file private and back it up before destructive changes.
DATABASE_URL=file:./data/cyberlab.sqlite
BCRYPT_COST=12
SEED_USER_PASSWORD=replace_for_local_seed_accounts

# Google OAuth
# Local authorized redirect URI:
# http://localhost:3001/api/auth/google/callback
# Deployed authorized redirect URI:
# https://your-api-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional override if the Google callback should differ from BACKEND_URL + /api/auth/google/callback
# GOOGLE_CALLBACK_URL=https://your-api-domain.com/api/auth/google/callback

# Course-bound AI tutor
AI_DAILY_LIMIT=20

# Razorpay starter
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# CLI admin
CLIADM_ADMIN_TOKEN=replace_with_local_admin_token
